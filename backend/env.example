POSTGRES_PASSWORD=change_me
JWT_SECRET=change_me_to_a_long_random_string
APP_ENV=development

# Per-client-IP rate limits (requests per minute) on public endpoints.
# AUTH_RATE_PER_MIN is the strict budget: failed logins (and register).
# AUTH_ATTEMPT_RATE_PER_MIN is a looser budget that counts every login attempt,
# successful ones included, to bound bcrypt CPU per client. ADMS_RATE_PER_MIN
# covers device ingestion and is PROVISIONAL until a real-device check.
AUTH_RATE_PER_MIN=10
AUTH_ATTEMPT_RATE_PER_MIN=60
ADMS_RATE_PER_MIN=600
# Comma-separated CIDRs of reverse proxies whose X-Real-IP header is trusted.
# Empty trusts nobody (the limiter keys on the TCP peer). docker-compose
# defaults this to the subnet of its own network (172.29.77.0/24, declared
# under networks.rrhh_go_net.ipam), because only nginx reaches the backend
# there. If you change that subnet, change this value too. Never list a broad
# private range (10/8, 172.16/12, 192.168/16) or anything untrusted clients
# can connect from directly.
TRUSTED_PROXY_CIDRS=172.29.77.0/24
